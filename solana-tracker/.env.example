# Copy to .env for local runs. In GitHub Actions these come from repo secrets instead.
# .env is gitignored — never commit real values.

# --- Required for alerts ---------------------------------------------------------
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id. Message your bot once, then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates  and read result[0].message.chat.id
TELEGRAM_CHAT_ID=

# --- Wallet tracking (read-only, public address only) -----------------------------
# Your Phantom receive address. NEVER put a seed phrase or private key anywhere.
WALLET_ADDRESS=

# --- RPC -------------------------------------------------------------------------
# The public endpoint is aggressively rate limited and will drop calls under load.
# A free Helius/QuickNode/Alchemy key makes this far more reliable:
#   https://helius.dev  ->  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Behaviour -------------------------------------------------------------------
# 1 = run everything but print alerts instead of sending them.
DRY_RUN=
LOG_LEVEL=info

# --- Screening thresholds (all optional; defaults shown) --------------------------
MIN_AGE_MINUTES=15
MAX_AGE_HOURS=24
MAX_ALERTS_PER_RUN=5
DEDUPE_DAYS=7

MIN_LIQUIDITY_USD=15000
MAX_LIQUIDITY_USD=5000000
MIN_VOLUME_24H_USD=25000
MIN_MARKET_CAP_USD=30000
MAX_MARKET_CAP_USD=20000000
MIN_TXNS_24H=150
MIN_HOLDERS=150
MAX_TOP10_PCT=25
MAX_SINGLE_HOLDER_PCT=8
MIN_LP_LOCKED_PCT=90
MAX_VOL_LIQ_RATIO=30
MIN_SELL_RATIO_24H=0.15
MAX_RUGCHECK_SCORE=40
MIN_SCORE=60
# Comma-separated RugCheck risk names to tolerate, e.g.:
# IGNORED_RUGCHECK_RISKS=Low amount of LP Providers
IGNORED_RUGCHECK_RISKS=

# --- Position alert thresholds ----------------------------------------------------
POSITION_MIN_VALUE_USD=25
POSITION_MOVE_PCT=25
POSITION_LIQ_DROP_PCT=45
POSITION_LIQ_FLOOR_USD=5000
# UTC hour for the daily holdings digest; -1 to disable.
DIGEST_HOUR_UTC=13

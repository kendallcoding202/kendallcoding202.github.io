# pumpbot configuration. Copy to .env and fill in.
# .env is gitignored and written chmod 600 by `npm run keygen`. Never commit it.

# ─── SAFETY INTERLOCK ────────────────────────────────────────────────────────
# PAPER=1 runs the full pipeline with simulated fills and spends nothing.
# Set PAPER=0 only when you have recorded the live feed, replayed it clean, and
# are ready to spend real SOL.
PAPER=1
# Starting balance used for paper-mode sizing.
PAPER_START_SOL=0.5

# ─── WALLET ──────────────────────────────────────────────────────────────────
# Created by `npm run keygen` — it writes the secret here and prints only the
# public address. Use a BURNER funded with only what you can lose entirely.
# Never paste this value into a chat, an issue, or a screenshot.
PRIVATE_KEY=

# The public RPC is heavily rate limited and will drop transactions under load.
# A free Helius key is strongly recommended for live trading:
#   https://helius.dev  ->  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com

# ─── PUMPPORTAL API KEY — REQUIRED, THE BOT CANNOT TRADE WITHOUT IT ──────────
# The free feed serves NEW TOKEN events only. subscribeTokenTrade needs a key
# funded with at least 0.02 SOL (~$2). Without it there are no buyer counts, so
# nothing passes the filter, and no price ticks, so exits cannot be managed.
# Get one at https://pumpportal.fun/trading-api
# DATA ONLY — trades are still built and signed locally with YOUR wallet.
PUMPPORTAL_API_KEY=

# ─── ALERTS AND PHONE CONTROL ────────────────────────────────────────────────
# From @BotFather. With these set you get push alerts AND can send the bot
# /status, /positions, /pause, /resume, /panic confirm.
# Only TELEGRAM_CHAT_ID is obeyed — it is the authorization boundary.
TELEGRAM_BOT_TOKEN=
# Message your bot once, then open:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_CHAT_ID=
# Scheduled digest interval in hours. 0 disables it — event alerts (entries,
# exits, halts) are unaffected either way.
TELEGRAM_SUMMARY_HOURS=4
# Whether explore (risk-taking) trades also alert. Off by default so a buzz always
# means real money moved. When on they are sent SILENTLY and tagged 🧪.
TELEGRAM_EXPLORE_ALERTS=0

# ─── POSITION SIZING ─────────────────────────────────────────────────────────
# Equity tiers as `minWalletSol:buySol`. Size steps UP as the account grows and
# back DOWN if it shrinks. Must include a 0: floor tier.
SIZE_TIERS=0:0.075,5:0.15
MAX_CONCURRENT_POSITIONS=4
# Leave at 0 to derive the deploy cap from the active tier (buySol x maxConcurrent).
MAX_DEPLOYED_SOL=0
# Never spend the wallet below this — fees must always be payable.
RESERVE_SOL=0.05

# ─── CIRCUIT BREAKERS ────────────────────────────────────────────────────────
# Realized loss in a UTC day that stops new entries (open positions still exit).
DAILY_LOSS_LIMIT_SOL=0.2
# Total realized loss that halts the bot until you clear it manually.
TOTAL_LOSS_LIMIT_SOL=0.35
MAX_CONSECUTIVE_LOSSES=6

# ─── EXECUTION ───────────────────────────────────────────────────────────────
# At 0.075 SOL a position this is ~0.7% of the trade, paid on entry AND exit.
# Raising it lands more transactions but eats more of a small position.
PRIORITY_FEE_SOL=0.0005
BUY_SLIPPAGE_PCT=12
# Exits must clear even in a falling market. Being stuck in is the worse failure.
SELL_SLIPPAGE_PCT=25
# pump.fun protocol fee plus the trade API cut, used for paper fills and P&L.
FEE_PCT=1.5
EXEC_MAX_RETRIES=3

# ─── ENTRY FILTER ────────────────────────────────────────────────────────────
# We do NOT buy at deploy. We watch each launch for this long first, because at
# retail latency the block-zero fill belongs to professional snipers.
OBSERVE_SECONDS=30
ABANDON_SECONDS=180
MIN_UNIQUE_BUYERS=12
MIN_BUY_SELL_RATIO=1.8
MIN_MARKET_CAP_SOL=25
MAX_MARKET_CAP_SOL=120
MAX_DEV_HOLD_PCT=12
REJECT_IF_DEV_SOLD=1
BANNED_WORDS=airdrop,claim,presale,official,giveaway

# ─── EXIT LADDER ─────────────────────────────────────────────────────────────
# `gainPct:sellPctOfOriginalBag`. The first rung recovers the whole stake:
# selling 67% at 1.5x returns ~1.005x cost, so the rest rides as house money.
LADDER=50:67,100:10,200:10,400:10
STOP_LOSS_PCT=30
# Exit anything that has not reached the first rung in this many seconds.
TIME_STOP_SECONDS=600
# Once a rung is hit, give back at most this much of the peak.
TRAILING_DRAWDOWN_PCT=50
# Bail if the bonding curve drains this far — the pump.fun analogue of an LP pull.
LIQUIDITY_DROP_PCT=60
# Exit if a held token has not produced a price update in this long. Holding a
# position we cannot price disables the stop-loss and the trailing stop.
STALE_PRICE_SECONDS=180

# ─── EXPLORATION (PAPER ONLY) ────────────────────────────────────────────────
# Buy a sample of the candidates the filter REJECTED, so we learn whether the
# filter is right. Hard-gated to paper — no variable enables this with real money.
# Explore trades are booked separately: they never touch the headline P&L, the
# loss limits, or the concurrency cap.
EXPLORE=1
EXPLORE_SAMPLE_RATE=0.25
EXPLORE_MAX_CONCURRENT=15

# ─── LEARNING ────────────────────────────────────────────────────────────────
LEARNING=1
# How long to follow a token after deciding on it, to label the outcome.
OUTCOME_WINDOW_MINUTES=15
MAX_SHADOW_TRACKED=80
# Minimum labelled samples before any threshold suggestion. Do not lower this
# because the report looks empty — below it, apparent edges are sampling noise.
MIN_SAMPLES_FOR_SUGGESTION=200
MIN_BUCKET_SAMPLES=30
# Keep this off. Tuning a live strategy on its own recent results overfits.
LEARNING_AUTO_APPLY=0

# ─── DASHBOARD ───────────────────────────────────────────────────────────────
DASHBOARD=1
DASHBOARD_PORT=8080
# Localhost only. To view from your laptop, tunnel rather than rebinding:
#   ssh -N -L 8080:localhost:8080 you@your-vps
# Binding to 0.0.0.0 requires DASHBOARD_TOKEN and exposes your wallet and P&L.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TOKEN=

# How often the pipeline summary prints. The first beat always comes early.
HEARTBEAT_SECONDS=60

LOG_LEVEL=info
